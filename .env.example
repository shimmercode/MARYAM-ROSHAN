# ---------------------------------------------------------------------------
# سالن زیبایی مریم روشن — نمونه تنظیمات محیط
# این فایل را به .env کپی کنید:  cp .env.example .env
# هرگز فایل .env را در گیت کامیت نکنید.
# ---------------------------------------------------------------------------

APP_NAME="سالن زیبایی مریم روشن"
APP_ENV=local              # local | production
APP_DEBUG=true             # در محیط production حتماً false
APP_URL=http://localhost:8000
APP_BASE_PATH=
APP_KEY=                   # با دستور: php tools/console.php key:generate
APP_TIMEZONE=Asia/Tehran

# ------------------------- پایگاه داده -------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maryam_roshan
DB_USER=root
DB_PASS=

# ------------------------- پیامک -------------------------
SMS_ENABLED=false
SMS_DRIVER=log             # log | kavenegar | melipayamak
SMS_API_KEY=
SMS_SENDER=
SMS_USERNAME=
SMS_PASSWORD=

# ------------------------- ایمیل -------------------------
MAIL_ENABLED=false
MAIL_DRIVER=log            # log | mail | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@maryamroshan.ir
MAIL_FROM_NAME="سالن زیبایی مریم روشن"

# ------------------------- پرداخت -------------------------
PAYMENT_ENABLED=false
PAYMENT_DRIVER=manual
PAYMENT_API_KEY=
PAYMENT_CALLBACK=/customer/payments/callback

# ------------------------- امنیت -------------------------
SESSION_DOMAIN=
TWO_FACTOR_ENABLED=false
